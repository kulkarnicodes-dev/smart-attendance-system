# Copy this file to ".env" and edit.

# --- Database ---
# Easiest (no install needed):
DATABASE_URL=sqlite:///./attendance.db
# MySQL (after creating database "smart_attendance"):
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/smart_attendance

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- First admin account (created automatically on first run) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Face recognition ---
# Cosine similarity needed to accept a match (higher = stricter). 0.40 - 0.55 is sensible.
MATCH_THRESHOLD=0.45
# Minimum detector confidence for a face
DETECT_THRESHOLD=0.85
# Max stored face samples per student
MAX_FACE_SAMPLES=25

# --- CORS (frontend URL) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- v2 additions (all optional) ---
# Matches between (MATCH_THRESHOLD - REVIEW_MARGIN) and MATCH_THRESHOLD go to teacher review instead of being marked
REVIEW_MARGIN=0.07
# Reject a new face sample that looks like another registered student
DUPLICATE_FACE_THRESHOLD=0.65
# Face must be at least this fraction of the frame width to be recognised
MIN_FACE_WIDTH_RATIO=0.10
# Lock an account after N wrong passwords for M minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10
